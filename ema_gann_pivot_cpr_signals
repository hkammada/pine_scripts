//@version=6
indicator("3 EMA + GANN + CPR + Pivot + Stoch RSI Filter", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ==========================================
// --- INPUTS (Group Master Selectors) ---
// ==========================================

// --- EMA GROUP ---
grp_ema = "EMA Settings"
enableEMA = input.bool(true, "MASTER: Enable EMA Group", group=grp_ema)
len1 = input.int(5, "EMA 1 Length", minval=1, group=grp_ema, active=enableEMA)
col1 = input.color(color.new(color.blue, 0), "EMA 1 Color", group=grp_ema, active=enableEMA)
len2 = input.int(13, "EMA 2 Length", minval=1, group=grp_ema, active=enableEMA)
col2 = input.color(color.new(color.orange, 0), "EMA 2 Color", group=grp_ema, active=enableEMA)
len3 = input.int(39, "EMA 3 Length", minval=1, group=grp_ema, active=enableEMA)
col3 = input.color(color.new(color.red, 0), "EMA 3 Color", group=grp_ema, active=enableEMA)

// --- CPR GROUP ---
grp_cpr = "CPR & Pivot Settings"
enableCPR  = input.bool(true, "MASTER: Enable CPR Group", group=grp_cpr)
pivotColor = input.color(color.new(color.black, 0), "Pivot Color", group=grp_cpr, active=enableCPR)
cprColor   = input.color(color.new(color.purple, 0), "TC/BC Color", group=grp_cpr, active=enableCPR)

// --- GANN GROUP ---
grp_gann = "Gann Settings"
enableGann = input.bool(true, "MASTER: Enable Gann Group", group=grp_gann)
multiplier = input.float(1.0, "Multiplier", minval=0.0001, group=grp_gann, active=enableGann)
use_prev_close = input.bool(false, "Use Yesterday's Close?", group=grp_gann, active=enableGann)
up_color = input.color(color.new(color.teal, 0), "Resistance Color", group=grp_gann, active=enableGann)
down_color = input.color(color.new(color.maroon, 0), "Support Color", group=grp_gann, active=enableGann)
show_labels = input.bool(true, "Show Labels", group=grp_gann, active=enableGann)

// --- STOCHASTIC RSI GROUP ---
grp_stoch = "Stochastic RSI Settings"
smoothK = input.int(3, "K Smoothing", minval=1, group=grp_stoch)
smoothD = input.int(3, "D Smoothing", minval=1, group=grp_stoch)
lengthRSI = input.int(14, "RSI Length", minval=1, group=grp_stoch)
lengthStoch = input.int(14, "Stochastic Length", minval=1, group=grp_stoch)

// --- SIGNALS GROUP ---
grp_sig = "Signal Settings"
enableSignals = input.bool(true, "MASTER: Enable Buy/Sell Signals", group=grp_sig)

// ==========================================
// --- CALCULATIONS ---
// ==========================================

// EMA Calculations
ema1 = ta.ema(close, len1)
ema2 = ta.ema(close, len2)
ema3 = ta.ema(close, len3)

// Stochastic RSI Calculation
rsi1 = ta.rsi(close, lengthRSI)
k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d = ta.sma(k, smoothD)

// CPR & Pivot Calculations
is_new_day = ta.change(time("D")) != 0
dHigh  = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
dLow   = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
dClose = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)

pivotPoint = (dHigh + dLow + dClose) / 3
bc = (dHigh + dLow) / 2
tc = (pivotPoint - bc) + pivotPoint

// Gann Calculations
var float gann_base = na
if is_new_day
    gann_base := use_prev_close ? dClose : open

calc_gann(float base, float angle, bool is_up) =>
    float root = math.sqrt(base * multiplier)
    float factor = angle / 180.0
    float res = is_up ? math.pow(root + factor, 2) : math.pow(root - factor, 2)
    res / multiplier

// ==========================================
// --- DRAWING LOGIC (Group Conditionals) ---
// ==========================================
var line[]  current_day_lines  = array.new_line()
var label[] current_day_labels = array.new_label()

add_level(float price, color col, string txt, int wid, string style_type) =>
    if not na(price)
        line_style = style_type == "Solid" ? line.style_solid : line.style_dashed
        line l = line.new(bar_index, price, bar_index, price, color=col, style=line_style, width=wid)
        array.push(current_day_lines, l)
        if show_labels
            label lb = label.new(bar_index, price, txt, color=color.new(col, 100), textcolor=col, style=label.style_label_left, size=size.small)
            array.push(current_day_labels, lb)

if is_new_day
    array.clear(current_day_lines)
    array.clear(current_day_labels)

    if enableCPR
        add_level(pivotPoint, pivotColor, "P", 2, "Solid")
        add_level(tc, cprColor, "TC", 1, "Solid")
        add_level(bc, cprColor, "BC", 1, "Solid")

    if enableGann
        float[] angles = array.from(45.0, 90.0, 180.0, 270.0, 360.0)
        for angle in angles
            add_level(calc_gann(gann_base, angle, true), up_color, str.tostring(angle) + "° R", 1, "Dashed")
            add_level(calc_gann(gann_base, angle, false), down_color, str.tostring(angle) + "° S", 1, "Dashed")

if array.size(current_day_lines) > 0
    for i = 0 to array.size(current_day_lines) - 1
        line.set_x2(array.get(current_day_lines, i), bar_index)
        if array.size(current_day_labels) > i
            label.set_x(array.get(current_day_labels, i), bar_index)

// ==========================================
// --- PLOTS & SIGNALS ---
// ==========================================

// EMAs plot
plot(enableEMA ? ema1 : na, "EMA 1", color=col1, linewidth=2)
plot(enableEMA ? ema2 : na, "EMA 2", color=col2, linewidth=2)
plot(enableEMA ? ema3 : na, "EMA 3", color=col3, linewidth=2)

// Signals Logic
if enableSignals
    // --- BUY SIGNAL ---
    // Condition: EMA Crossover + Stoch RSI between 0-50 + Upward direction
    buyStochInRange = k >= 0 and k <= 50
    buyStochUpward  = k > k[1]
    emaBuyCondition = ta.crossover(ema1, ema3)
    
    if emaBuyCondition and buyStochInRange and buyStochUpward
        label.new(bar_index, low, "BUY", color=color.green, textcolor=color.white, style=label.style_label_up)

    // --- SELL SIGNAL ---
    // Condition: EMA Crossunder + Stoch RSI between 50-100 + Downward direction
    sellStochInRange = k >= 50 and k <= 100
    sellStochDownward = k < k[1]
    emaSellCondition = ta.crossunder(ema1, ema3)

    if emaSellCondition and sellStochInRange and sellStochDownward
        label.new(bar_index, high, "SELL", color=color.red, textcolor=color.white, style=label.style_label_down)
